# ─────────────────────────────────────────────────────────────
#  LabPilot configuration
#  Copy to .env and fill in what you have. Sources without
#  settings are skipped. With nothing configured LabPilot
#  starts in demo mode.
# ─────────────────────────────────────────────────────────────

# General
LABPILOT_PORT=38471                # poort op je host (container luistert op 8080)
LABPILOT_TITLE=LabPilot
POLL_INTERVAL=15                 # seconds between polls
ACTIONS_ENABLED=false            # true = allow start/stop VMs, block clients, start jobs
LABPILOT_PASSWORD=               # set to protect the dashboard with a login
LABPILOT_SECRET=                 # random string to sign session cookies (openssl rand -hex 32)
SNAPSHOT_MAX_AGE_DAYS=14
LOW_SPACE_PCT=15
TZ=Europe/Amsterdam
# DEMO_MODE=true                 # force demo data

# VMware ESXi (or vCenter)
# Tip: create a dedicated read-only role/user, give it VM power rights only if ACTIONS_ENABLED=true
ESXI_HOST=192.168.1.10
ESXI_USER=labpilot
ESXI_PASSWORD=
ESXI_VERIFY_SSL=false

# Synology DSM
# Tip: a dedicated user in the administrators group (needed for storage/system APIs), with 2FA disabled for that user
SYNOLOGY_URL=https://192.168.1.20:5001
SYNOLOGY_USER=labpilot
SYNOLOGY_PASSWORD=
SYNOLOGY_VERIFY_SSL=false

# UniFi OS (UDM / UDM Pro / UDM SE / UCG)
# Use a local-only admin (Settings › Admins) or an API key
UNIFI_URL=https://192.168.1.1
UNIFI_USER=labpilot
UNIFI_PASSWORD=
# UNIFI_API_KEY=
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# Veeam Backup & Replication (v12+ REST API, port 9419)
VEEAM_URL=https://192.168.1.30:9419
VEEAM_USER=LAB\labpilot
VEEAM_PASSWORD=
VEEAM_API_VERSION=1.1-rev2
VEEAM_VERIFY_SSL=false
